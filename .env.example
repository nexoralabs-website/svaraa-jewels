# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Svaraa Jewels"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Kolkata

# ── Locale ───────────────────────────────────────────────────────────────────
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

# ── Database (MySQL recommended for production) ───────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=svaraa_jewels
DB_USERNAME=svaraa_user
DB_PASSWORD=
DB_ROOT_PASSWORD=
RUN_MIGRATIONS=false

# ── Cache (Redis recommended for production) ──────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=svaraa_

# ── Session (Redis recommended for production) ───────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=180
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true

# ── Queue (Redis recommended for production) ──────────────────────────────────
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=svaraa_queue

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="orders@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY=rzp_live_XXXXXXXXXXXX
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Payment Feature Flag ──────────────────────────────────────────────────────
# false = online payments (card/UPI) disabled for customers; COD still works.
# true  = full payment flow enabled. Change this once credentials are confirmed.
PAYMENTS_ENABLED=false

# ── Meilisearch ──────────────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

# ── Storage ──────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_DISK=local # Set to 's3' for Cloudflare R2 / AWS S3
# For Cloudflare R2 / AWS S3:
# FILESYSTEM_PUBLIC_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=svaraa-media
# AWS_URL=https://your-custom-domain.com # Optional: Custom domain for R2
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ── Payment Monitoring ────────────────────────────────────────────────────────
PAYMENT_ALERT_EMAIL="alerts@yourdomain.com"
PAYMENT_ALERT_WEBHOOK_FAILURES=5
PAYMENT_ALERT_RECONCILIATION_FAILURES=3
PAYMENT_ALERT_STOCK_CONFLICTS=1
PAYMENT_ALERT_QUEUE_BACKLOG=50
PAYMENT_ALERT_FAILED_JOBS=1
PAYMENT_ALERT_CAPTURE_SUCCESS_RATE_MIN=90

# ── Filament Admin ────────────────────────────────────────────────────────────
# Admin panel password is set via php artisan make:filament-user

VITE_APP_NAME="${APP_NAME}"
